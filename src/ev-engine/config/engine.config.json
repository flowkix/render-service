{
  "configVersion": "v1",
  "zonesVersion": "zones.v1.json",
  "vehicles": {
    "mixobar": { "zonesVersion": "zones-mixobar.v1.json" }
  },
  "promptsVersion": "prompts/presets.v1.json",
  "correctionsVersion": "prompts/corrections.v1.json",
  "simplePromptsVersion": "prompts/presets-simple.v1.json",
  "simpleCorrectionsVersion": "prompts/corrections-simple.v1.json",
  "decorPromptsVersion": "prompts/presets-decor.v1.json",
  "decorCorrectionsVersion": "prompts/corrections-decor.v1.json",
  "stages": {
    "branding": {
      "provider": "gemini",
      "model": "gemini-3-pro-image",
      "resolution": "2K",
      "aspectRatio": "4:3",
      "challengers": [
        { "provider": "gemini", "model": "gemini-3.1-flash-image" },
        { "provider": "fal-kontext", "model": "flux-pro/kontext/max" }
      ]
    },
    "scene": {
      "provider": "gemini",
      "model": "gemini-3-pro-image",
      "resolution": "2K",
      "aspectRatio": "16:9",
      "challengers": [
        { "provider": "gemini", "model": "gemini-3.1-flash-image" }
      ]
    },
    "decorReference": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-image",
      "resolution": "2K",
      "aspectRatio": "4:3"
    }
  },
  "scorer": {
    "provider": "gemini",
    "model": "gemini-3-flash-preview",
    "fallbackModels": ["gemini-2.5-flash", "gemini-3.5-flash"]
  },
  "fidelityGate": {
    "enabled": true,
    "maxAttempts": 3,
    "_doc": "Runtime EV structure check after every runFull/runSimpleFull (pipeline/fidelity-gate.js): judge with `scorer` vs the raw EV reference, regenerate up to maxAttempts-1 times with a corrective prefix, deliver best attempt flagged if none passes. Only the delivered attempt is billed. Added 2026-09-30."
  },
  "limits": {
    "maxInlinePayloadBytes": 8000000,
    "costCapPerImageUsd": 0.25,
    "timeoutMs": 180000
  }
}
